call SaveReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$5CB22BAC,1.+I2R(LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$B5D40C50))*.01)
