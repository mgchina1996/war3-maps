if LoadBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$17894772)==false then
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49303735))
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"获得晴天风铃娃娃buff!|cff00ff00（请在宠物技能领取收益）|r")
