function InitTrig____________________079_______u takes nothing returns nothing
set gg_trg____________________079_______u=CreateTrigger()
call TriggerRegisterUnitEvent(gg_trg____________________079_______u,gg_unit_E017_0309,EVENT_UNIT_DROP_ITEM)
call TriggerAddCondition(gg_trg____________________079_______u,Condition(function Trig____________________079_______uConditions))
call TriggerAddAction(gg_trg____________________079_______u,function Trig____________________079_______uActions)
endfunction
function Trig____________________080Conditions takes nothing returns boolean
return udg_wjyx[GetPlayerId(GetTriggerPlayer())]==udg_AYX[42] and LoadInteger(YDHT,GetHandleId(GetTriggerPlayer()),$A75AA5D5)>=1 and GetEventPlayerChatString()=="-Q" or GetEventPlayerChatString()=="-R" or GetEventPlayerChatString()=="-W" or GetEventPlayerChatString()=="-E" or GetEventPlayerChatString()=="-D"
endfunction
function Trig____________________080Actions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
