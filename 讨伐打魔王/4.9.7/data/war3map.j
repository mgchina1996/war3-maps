function InitTrig_______B_________u takes nothing returns nothing
set gg_trg_______B_________u=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_______B_________u,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_______B_________u,Condition(function Trig_______B_________uConditions))
call TriggerAddAction(gg_trg_______B_________u,function Trig_______B_________uActions)
endfunction
