function ASound takes string s returns nothing
local sound sd=CreateSound(s,false,false,false,0,10,"")
call PlaySoundBJ(sd)
call SetSoundVolume(sd,110)
set udg_Last_ASound=sd
set sd=null
endfunction
function ASound_Cut takes string s,unit u returns nothing
local sound sd=null
set sd=CreateSound(s,false,true,true,10,10,"DefaultEAXON")
call SetSoundDuration(sd,1123)
call SetSoundChannel(sd,0)
call SetSoundVolume(sd,127)
call SetSoundPitch(sd,1.)
call SetSoundDistances(sd,1000.,10000.)
call SetSoundDistanceCutoff(sd,3000.)
call SetSoundConeAngles(sd,0.,0.,127)
call SetSoundConeOrientation(sd,0.,0.,0.)
call PlaySoundOnUnitBJ(sd,100,u)
set u=null
set sd=null
endfunction
