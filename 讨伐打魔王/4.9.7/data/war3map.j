function Trig_3301F91Actions takes nothing returns nothing
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"群号","7群：811126647","ReplaceableTextures\\CommandButtons\\BTN1.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"关于模型","感谢“家庭教师-罪与罚”提供的家教模型\n感谢菲亚的小天使、刀藤、文文、...索妮娅、美游\n感谢菲亚赞助提供的蕾米莉亚、犬走椛\n感谢JUMP大赛提供的樱满集\n神昏提供的魔王夜夜\n感谢若雪儿提供的穹妹\n感谢蓬莱双姬物语提供的早苗\n感谢天谕幻雪提供的佩斯特\n感谢X10提供的清姬\n感谢菲特提供的和泉纱雾\n感谢本子奈提供的亚丝娜\n感谢柠檬提供的辉夜\n感谢大肥叶提供的秦心、钥匙孔、爱、BB酱、和服夏娜、还有好多不记得了\n感谢全明星战役提供的泳装夏娜\n感谢ACG提供的校服夏娜\n感谢蓬莱之旅提供的妹红\n感谢U9提供的模型\n请不要提取以上相关模型\n\n如果有模型侵权的话，加我QQ：2396865055，我会处理的！","ReplaceableTextures\\CommandButtons\\BTN1.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"关于指令","大部分指令：\n“+”  提高视角\n“-”  降低视角\n“-sj”  恢复视角\n“-zs”  自杀\n“hg”   回城\n“hc”   返回泉水\n“-gh”打开/关闭当局共享\n“-sx”  查看自身属性\n“-sjyx”可以随机，包括积分英雄\n“-min”投票快速开启剧情，需要打完30波\n按下方向键“↑”，可以花费20木头增加20W金币\n按下方向键“↓”可以把10W金币换成10木头","ReplaceableTextures\\CommandButtons\\BTN1.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"关于属性","1%属性（火焰/冰冻/黑暗/闪电）=1%技能伤害加成\n技能没写属性的就是没属性。\n地图伤害计算：基础伤害*属性强化*伤害增加","ReplaceableTextures\\CommandButtons\\BTN1.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"关于攻略","基本流程先送水然后出星陨，然后刷怪升到满级。\n没有防具，直接做武器，做首饰。武器升级和首饰升级都在物品文本里面写着，如果找不到材料出处就看一下传送副本。\n高级武器在地图左边那块地方的乌贼娘有合成。\n顶级武器再地图右下角那块地方灵梦有合成。\n特别注意的是，第10波后有剧情任务必须打，进入后山的方法：直接在传送副本商店那里有传送\n21波后：招财喵的地盘会被某玲占领，会给敌人给予强大的光环，如果你发现打不过怪物，就应该马上去解决他。\n难度越高，剧情和最终boss都是不同的。\n完整攻略。。。。好长啊，我才懒得写","ReplaceableTextures\\CommandButtons\\BTN1.blp")
call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED,"关于积分","这个积分的问题。\n----难度越高获得的也越多----\n进攻boss：5积分\n紫妈：20积分\n萝：10积分（需要难度3以上，难度5以下）\n真萝：15积分（需要难度5以上）\n黑罗：20积分（需要难度5以上）\n神玲：50积分（需要难度5以上）\n守家：每击杀150个单位增加1点积分\n红幕牌子：20/50/100积分（几率比较小）\n---------------------------------------\n首次通关难度1：额外获得100分\n首次通关难度2：额外获得200分\n首次通关难度3：额外获得400分\n首次通关难度6：额外获得500分（如果通关难度6的时候还没拿难度5的奖励，就会同时获得奖励）\n---------------------------------------\n平台的房间显示积分是有延迟的，输入“-jf”可以显示准确的积分","ReplaceableTextures\\CommandButtons\\BTN1.blp")
endfunction
