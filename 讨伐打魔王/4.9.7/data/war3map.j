function Trig__________uActions takes nothing returns nothing
local integer ydul_l
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
set ydul_l=1
loop
exitwhen ydul_l>5
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC,GetRandomInt(1,20))
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)==1 and S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),8,8))!=1 then
call SaveForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB,YDWEGetForceOfPlayerNull(ConvertedPlayer(ydul_l)))
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"|cffffcc00雪人下面藏着一只佩斯特|r")
call DestroyForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB))
if SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),1,1)=="1" or SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),1,1)=="0" then
call SaveStr(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$2F128C38,SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),1,7))
call SaveStr(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$92F49EBB,SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),9,11))
call DzAPI_Map_StoreString(ConvertedPlayer(ydul_l),"CHshuxing",LoadStr(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$2F128C38)+("1"+LoadStr(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$92F49EBB)))
call SetPlayerTechResearchedSwap($52303049,1,ConvertedPlayer(ydul_l))
else
call DzAPI_Map_StoreString(ConvertedPlayer(ydul_l),"CHshuxing","00000001000")
call SetPlayerTechResearchedSwap($52303049,1,ConvertedPlayer(ydul_l))
endif
else
call DoNothing()
endif
set ydul_l=ydul_l+1
endloop
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
