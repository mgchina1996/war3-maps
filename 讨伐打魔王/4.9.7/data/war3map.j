function Trig_6004__________________2_______uActions takes nothing returns nothing
local integer ydul_l
set ydul_l=1
loop
exitwhen ydul_l>5
set udg_FCH[ydul_l]=DzAPI_Map_GetStoredInteger(ConvertedPlayer(ydul_l),"FCH")
if udg_FCH[ydul_l]==0 then
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),1,1))==1 then
set udg_FCH[ydul_l]=udg_FCH[ydul_l]+1000
else
endif
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),2,2))==1 then
set udg_FCH[ydul_l]=udg_FCH[ydul_l]+100
else
call DoNothing()
endif
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),3,3))==1 then
set udg_FCH[ydul_l]=udg_FCH[ydul_l]+10
else
call DoNothing()
endif
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),4,4))==1 then
set udg_FCH[ydul_l]=udg_FCH[ydul_l]+1
else
call DoNothing()
endif
if udg_FCH[ydul_l]==0 then
set udg_FCH[ydul_l]=2
else
call DoNothing()
endif
set udg_CHde2[ydul_l]="0000"
call DzAPI_Map_StoreInteger(ConvertedPlayer(ydul_l),"FCH",udg_FCH[ydul_l])
else
if udg_FCH[ydul_l]>=1 and udg_FCH[ydul_l]!=2 then
if udg_FCH[ydul_l]>=1000 then
set udg_CHde2[ydul_l]=SubStringBJ(I2S(udg_FCH[ydul_l]),1,4)
else
if udg_FCH[ydul_l]>=100 then
set udg_CHde2[ydul_l]="0"+SubStringBJ(I2S(udg_FCH[ydul_l]),1,3)
else
if udg_FCH[ydul_l]>=10 then
set udg_CHde2[ydul_l]="00"+SubStringBJ(I2S(udg_FCH[ydul_l]),1,2)
else
if udg_FCH[ydul_l]>=1 then
set udg_CHde2[ydul_l]="000"+SubStringBJ(I2S(udg_FCH[ydul_l]),1,1)
else
call DoNothing()
endif
endif
endif
endif
else
call DoNothing()
endif
endif
set ydul_l=ydul_l+1
endloop
endfunction
