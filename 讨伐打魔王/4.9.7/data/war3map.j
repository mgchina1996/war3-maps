if LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$2EE737DB)==0 then
if LoadReal(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$2F1C4FFB)<=.8 then
call UnitAddItemByIdSwapped($4930354D,GetTriggerUnit())
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"领取了一份儿童节礼物~")
call SaveInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$2EE737DB,1)
