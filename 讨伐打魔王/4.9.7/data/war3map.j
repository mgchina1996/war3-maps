if LoadBoolean(YDHT,StringHash("魔界最终战"),$6646C098)==true or LoadBoolean(YDHT,StringHash("最终战"),$639BDBDD)==true then
if LoadInteger(YDHT,GetHandleId(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$FDF65382)),$E2C78270)>0 then
call SaveInteger(YDHT,GetHandleId(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$FDF65382)),$E2C78270,LoadInteger(YDHT,GetHandleId(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$FDF65382)),$E2C78270)-1)
