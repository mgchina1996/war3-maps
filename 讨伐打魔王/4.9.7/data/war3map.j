call SetUnitManaBJ(udg_AYX[43],GetUnitState(udg_AYX[43],UNIT_STATE_MANA)+1.*GetUnitState(udg_AYX[43],UNIT_STATE_MAX_MANA))
else
call SetUnitManaBJ(udg_AYX[43],GetUnitState(udg_AYX[43],UNIT_STATE_MANA)+.03*GetUnitState(udg_AYX[43],UNIT_STATE_MAX_MANA))
endif
if LoadBoolean(YDHT,GetHandleId(GetOwningPlayer(udg_AYX[43])),$8A8B65AF)==false then
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(udg_AYX[43])),$8A8B65AF,true)
call SaveTextTagHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$32A9E4C8,CreateTextTag())
call SetTextTagPermanent(LoadTextTagHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$32A9E4C8),true)
set ydl_timer=CreateTimer()
call SaveTextTagHandle(YDLOC,GetHandleId(ydl_timer),$32A9E4C8,LoadTextTagHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$32A9E4C8))
call TimerStart(ydl_timer,.03,true,function Trig____________________091Func002Func005T)
else
endif
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
