function Trig____________________063Actions takes nothing returns nothing
local integer ydul_l
local timer ydl_timer
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveStr(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$214C62CC,GetUnitName(GetTriggerUnit()))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49304553))
call DisplayTextToForce(GetPlayersAll(),"|cffcc99ff完成任务：|r寻找古明地觉")
call SaveBoolean(YDHT,StringHash("最终boss增强"),$42E3C69A,true)
call SaveInteger(YDHT,StringHash("技能伤害"),$4D696D8F,25)
if udg_ZXRS==1 then
call AdjustPlayerStateBJ(2500,GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_LUMBER)
call UnitAddAbility(udg_wjyx[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],$41305452)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",udg_wjyx[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],"origin"))
call DisplayTextToForce(GetPlayersAll(),"|cff00ff00任务奖励：2500木头/30000全属性（单人）|r")
else
set ydul_l=1
loop
exitwhen ydul_l>5
call AdjustPlayerStateBJ(1000,ConvertedPlayer(ydul_l),PLAYER_STATE_RESOURCE_LUMBER)
call UnitAddAbility(udg_wjyx[ydul_l-1],$41305452)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",udg_wjyx[ydul_l-1],"origin"))
set ydul_l=ydul_l+1
endloop
call DisplayTextToForce(GetPlayersAll(),"|cff00ff00任务奖励：1000木头/30000全属性|r")
endif
