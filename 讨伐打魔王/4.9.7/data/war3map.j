if YDWEUnitHasItemOfTypeBJNull(udg_wjyx[GetPlayerId(GetTriggerPlayer())],$49304636)==true then
if GetItemCharges(YDWEGetItemOfTypeFromUnitBJNull(udg_wjyx[GetPlayerId(GetTriggerPlayer())],$49304636))>=2 then
