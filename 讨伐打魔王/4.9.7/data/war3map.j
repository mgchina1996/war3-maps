endif
endfunction
function Trig_tips_________uActions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC,GetRandomInt(1,4))
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)==1 then
if LoadInteger(YDHT,StringHash("技能难度"),$AA04A09)>=5 then
call DisplayTextToForce(GetPlayersAll(),"Tip：击败21波剧情boss后，可以选择boss路线\nTip2：如果遇到对最终boss无法造成伤害请输入“-bug”")
else
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC,GetRandomInt(1,2))
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)==1 then
call DisplayTextToForce(GetPlayersAll(),"Tips：输入“-sx”可以查看自身的属性\nTips2：如果遇到对最终boss无法造成伤害请输入“-bug”\ntips3：出现卡顿时，输入“-tx”可以关闭一些特效")
else
call DisplayTextToForce(GetPlayersAll(),"难度3或以上可以体验全部剧情和boss")
endif
endif
else
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)==2 then
call DisplayTextToForce(GetPlayersAll(),"Tip：按方向键“↑”能快速把20木头换成20W\n     按方向键“↓”能快速把10W换成10木头\n     ")
else
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)==3 then
call DisplayTextToForce(GetPlayersAll(),"Tip：专属强化需要传送至地图左边，并单独击杀进攻boss")
else
call DisplayTextToForce(GetPlayersAll(),"|cff00ff00Tip：|r|cffffcc00橙色字是物理伤害，计算护甲并且享受破甲加成|r\n     |cffcc99ff紫色字是魔法伤害，计算魔抗|r")
endif
endif
endif
call EnumItemsInRectBJ(GetPlayableMapRect(),function Trig_tips_________uFunc003A)
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
