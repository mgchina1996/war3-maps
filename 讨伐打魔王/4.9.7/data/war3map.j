function Trig_8008_______________1Conditions takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true and GetItemTypeId(GetManipulatedItem())==$49304532
endfunction
function Trig_8008_______________1Actions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB,YDWEGetForceOfPlayerNull(GetOwningPlayer(GetTriggerUnit())))
if LoadBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$7611B70F)==false then
if LoadBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$AAD9E8CF)==true then
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$7611B70F,true)
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$AC4FAB9C,true)
call DzAPI_Map_StoreBoolean(GetOwningPlayer(GetTriggerUnit()),"CHyongyou",true)
call DzAPI_Map_StoreBoolean(GetOwningPlayer(GetTriggerUnit()),"kexiugaiCH",true)
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"重置成功")
call SetPlayerName(GetOwningPlayer(GetTriggerUnit()),udg_WJmingzi[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))])
call SelectUnitForPlayerSingle(gg_unit_n02M_0310,GetOwningPlayer(GetTriggerUnit()))
else
if udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1]>=12000 then
set udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1]=udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1]-12000
call DzAPI_Map_StoreInteger(GetOwningPlayer(GetTriggerUnit()),"JF",udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1])
call DzAPI_Map_Stat_SetStat(GetOwningPlayer(GetTriggerUnit()),"JF",I2S(udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1]))
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$7611B70F,true)
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$AC4FAB9C,true)
call DzAPI_Map_StoreBoolean(GetOwningPlayer(GetTriggerUnit()),"CHyongyou",true)
call DzAPI_Map_StoreBoolean(GetOwningPlayer(GetTriggerUnit()),"kexiugaiCH",true)
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"购买成功，当前剩余积分："+I2S(udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1]))
call SelectUnitForPlayerSingle(gg_unit_n02M_0310,GetOwningPlayer(GetTriggerUnit()))
else
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"积分不足："+I2S(udg_JF[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1]))
endif
endif
else
call SelectUnitForPlayerSingle(gg_unit_n02M_0310,GetOwningPlayer(GetTriggerUnit()))
endif
call DestroyForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB))
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
