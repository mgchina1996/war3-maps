set gg_trg_730__________________u=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_730__________________u,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(gg_trg_730__________________u,Condition(function Trig_730__________________uConditions))
call TriggerAddAction(gg_trg_730__________________u,function Trig_730__________________uActions)
endfunction
