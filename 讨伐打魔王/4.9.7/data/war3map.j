call UnitRemoveAbility(udg_WJBB[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],$41303237)
call UnitAddAbility(udg_WJBB[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],$41305450)
