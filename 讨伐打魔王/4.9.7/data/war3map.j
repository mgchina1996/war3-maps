call DzAPI_Map_StoreBoolean(ConvertedPlayer(ydul_l2),"CW1",true)
call DisplayTextToForce(YDWEGetForceOfPlayerNull(ConvertedPlayer(ydul_l2)),"-------------------------------------------------------------------------分割线-------------------------\n魔王对你卖了一个萌，并表示愿意跟随你~")
