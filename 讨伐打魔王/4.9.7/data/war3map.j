function InitTrig__________________________010 takes nothing returns nothing
set gg_trg__________________________010=CreateTrigger()
call TriggerRegisterPlayerUnitEventSimple(gg_trg__________________________010,Player(6),EVENT_PLAYER_UNIT_DEATH)
