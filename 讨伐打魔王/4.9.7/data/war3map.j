function InitTrig____________________051 takes nothing returns nothing
set gg_trg____________________051=CreateTrigger()
call TriggerRegisterDialogEvent(gg_trg____________________051,udg_wuyiDHK[1])
call TriggerRegisterDialogEvent(gg_trg____________________051,udg_wuyiDHK[2])
call TriggerRegisterDialogEvent(gg_trg____________________051,udg_wuyiDHK[3])
call TriggerRegisterDialogEvent(gg_trg____________________051,udg_wuyiDHK[4])
call TriggerRegisterDialogEvent(gg_trg____________________051,udg_wuyiDHK[5])
call TriggerAddAction(gg_trg____________________051,function Trig____________________051Actions)
endfunction
function Trig____________________093Conditions takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())==$49303457 or GetItemTypeId(GetManipulatedItem())==$4930354A and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true
endfunction
function Trig____________________093Actions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
