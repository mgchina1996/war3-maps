function Trig_6004__________________2Actions takes nothing returns nothing
local integer ydul_l
set ydul_l=1
loop
exitwhen ydul_l>5
set udg_FJF[ydul_l]=DzAPI_Map_GetStoredInteger(ConvertedPlayer(ydul_l),"FJF")
if udg_FJF[ydul_l]>=0 then
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),1,1))==1 then
set udg_FJF[ydul_l]=udg_FJF[ydul_l]+1000
else
endif
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),2,2))==1 then
set udg_FJF[ydul_l]=udg_FJF[ydul_l]+100
else
call DoNothing()
endif
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),3,3))==1 then
set udg_FJF[ydul_l]=udg_FJF[ydul_l]+10
else
call DoNothing()
endif
if S2I(SubStringBJ(DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"CHshuxing"),4,4))==1 then
set udg_FJF[ydul_l]=udg_FJF[ydul_l]+1
else
call DoNothing()
endif
set udg_FJF[ydul_l]=udg_FJF[ydul_l]+10000
set udg_CHde[ydul_l]=SubStringBJ(I2S(udg_FJF[ydul_l]),2,5)
set udg_FJF[ydul_l]=udg_FJF[ydul_l]-10000
set udg_FJF[ydul_l]=udg_FJF[ydul_l]-10000
call DzAPI_Map_StoreInteger(ConvertedPlayer(ydul_l),"FJF",udg_FJF[ydul_l])
else
set udg_FJF[ydul_l]=udg_FJF[ydul_l]+10000
if udg_FJF[ydul_l]>0 then
if udg_FJF[ydul_l]>=1000 then
set udg_CHde[ydul_l]=SubStringBJ(I2S(udg_FJF[ydul_l]),1,4)
else
if udg_FJF[ydul_l]>=100 then
set udg_CHde[ydul_l]="0"+SubStringBJ(I2S(udg_FJF[ydul_l]),1,3)
else
if udg_FJF[ydul_l]>=10 then
set udg_CHde[ydul_l]="00"+SubStringBJ(I2S(udg_FJF[ydul_l]),1,2)
else
set udg_CHde[ydul_l]="000"+SubStringBJ(I2S(udg_FJF[ydul_l]),1,1)
endif
endif
endif
else
set udg_CHde[ydul_l]="0"
endif
set udg_FJF[ydul_l]=udg_FJF[ydul_l]-10000
endif
set ydul_l=ydul_l+1
endloop
endfunction
