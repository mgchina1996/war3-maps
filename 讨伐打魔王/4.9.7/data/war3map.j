function Trig_11333shenjiangActions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB,YDWEGetForceOfPlayerNull(GetOwningPlayer(GetTriggerUnit())))
if YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit(),$49304B42)==true and YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit(),$49303355)==true or YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit(),$4930385A)==true and YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit(),$4930444E)==true or YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit(),$49304730)==true then
call SetUnitAnimation(gg_unit_n02L_0467,"Attack Slam")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",gg_unit_n02L_0467,"origin"))
if YDWEUnitHasItemOfTypeBJNull(GetTriggerUnit(),$4930385A)==true then
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$4930385A))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49304B42))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$4930444E))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49304730))
call UnitAddItemByIdSwapped($49304657,GetTriggerUnit())
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"|cffffcc00这树枝应该触碰过神力，用起来得心应手，一下子就成功了|r")
else
if GetRandomInt(1,100)<=15+LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1) then
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49303355))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49304B42))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$4930444E))
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49304730))
call UnitAddItemByIdSwapped($49304657,GetTriggerUnit())
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"|cffffcc00老头我技术不输往年，终于成功了|r")
call SaveInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1,0)
else
if GetRandomInt(1,100)<=45+LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1) then
call RemoveItem(YDWEGetItemOfTypeFromUnitBJNull(GetTriggerUnit(),$49303355))
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"哎呀，一个分神不小心把你的材料弄碎了，这不能怪我，凡事都有风险")
call SaveInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1,LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1)+10)
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"|cffffcc00系统：|r成功率提高10%（"+I2S(20+LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1))+"%）")
else
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"失败了，再来！")
call SaveInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1,LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1)+5)
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"|cffffcc00系统：|r成功率提高5%（"+I2S(20+LoadInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$83DB61D1))+"%）")
endif
endif
endif
else
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"你拿老头我寻开心是吧，没有材料还来胡闹，木头没收了！")
endif
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
