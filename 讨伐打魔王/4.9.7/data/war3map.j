function Trig_3000__________________uActions takes nothing returns nothing
local integer ydul_l
set udg_WJmingzi[0]=GetPlayerName(Player(0))
set udg_WJmingzi[1]=GetPlayerName(Player(1))
set udg_WJmingzi[2]=GetPlayerName(Player(2))
set udg_WJmingzi[3]=GetPlayerName(Player(3))
set udg_WJmingzi[4]=GetPlayerName(Player(4))
set ydul_l=1
loop
exitwhen ydul_l>5
if LoadBoolean(YDHT,GetHandleId(ConvertedPlayer(ydul_l)),$7611B70F)==true and LoadBoolean(YDHT,GetHandleId(ConvertedPlayer(ydul_l)),$AC4FAB9C)==false and LoadBoolean(YDHT,GetHandleId(ConvertedPlayer(ydul_l)),$3ACA3FE)==false then
call SaveStr(YDHT,GetHandleId(ConvertedPlayer(ydul_l)),$CC5786BD,DzAPI_Map_GetStoredString(ConvertedPlayer(ydul_l),"WJCH1"))
call SetPlayerName(ConvertedPlayer(ydul_l),LoadStr(YDHT,GetHandleId(ConvertedPlayer(ydul_l)),$CC5786BD)+udg_WJmingzi[ydul_l-1])
else
call DoNothing()
endif
set ydul_l=ydul_l+1
endloop
endfunction
