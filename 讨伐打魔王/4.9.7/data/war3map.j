function Trig_2409____________10_______________uActions takes nothing returns nothing
if LoadBoolean(YDHT,GetHandleId(GetTriggerPlayer()),$13B436D5)==false then
call SaveBoolean(YDHT,GetHandleId(GetTriggerPlayer()),$13B436D5,true)
if GetPlayerSlotState(Player(0))==PLAYER_SLOT_STATE_PLAYING then
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)+1)
else
call DoNothing()
endif
if GetPlayerSlotState(Player(1))==PLAYER_SLOT_STATE_PLAYING then
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)+1)
else
call DoNothing()
endif
if GetPlayerSlotState(Player(2))==PLAYER_SLOT_STATE_PLAYING then
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)+1)
else
call DoNothing()
endif
if GetPlayerSlotState(Player(3))==PLAYER_SLOT_STATE_PLAYING then
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)+1)
else
call DoNothing()
endif
if GetPlayerSlotState(Player(4))==PLAYER_SLOT_STATE_PLAYING then
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)+1)
else
call DoNothing()
endif
if GetTriggerPlayer()==Player(0) then
set udg_KSkaiqi=udg_KSkaiqi+5
else
set udg_KSkaiqi=udg_KSkaiqi+1
endif
if LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)<=2 then
if udg_KSkaiqi>=LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)-0 then
call DisableTrigger(GetTriggeringTrigger())
call DisplayTextToForce(GetPlayersAll(),"10秒后开始")
call StartTimerBJ(udg_ZHDSJ,false,10.)
else
call DisplayTextToForce(GetPlayersAll(),"还需要等待的人数："+I2S(LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)-udg_KSkaiqi))
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,0)
endif
else
if udg_KSkaiqi>=LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)-1 then
call DisableTrigger(GetTriggeringTrigger())
call DisplayTextToForce(GetPlayersAll(),"10秒后开始")
call StartTimerBJ(udg_ZHDSJ,false,10.)
else
call DisplayTextToForce(GetPlayersAll(),"还需要等待的人数："+I2S(LoadInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D)-1-udg_KSkaiqi))
call SaveInteger(YDHT,StringHash("玩家人数开启"),$F9C2C19D,0)
endif
endif
else
call DoNothing()
endif
endfunction
