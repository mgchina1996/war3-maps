function Trig____________________094Actions takes nothing returns nothing
local timer ydl_timer
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB,YDWEGetForceOfPlayerNull(GetOwningPlayer(GetTriggerUnit())))
call SaveUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$FDF65382,GetTriggerUnit())
if GetItemTypeId(GetManipulatedItem())==$4930354D then
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC,GetRandomInt(1,40))
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)<=12 then
set ydl_timer=CreateTimer()
call SaveForceHandle(YDLOC,GetHandleId(ydl_timer),$DFB448FB,LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB))
call SaveUnitHandle(YDLOC,GetHandleId(ydl_timer),$FDF65382,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$FDF65382))
call SaveInteger(YDLOC,GetHandleId(ydl_timer),$A0136A6F,LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$A0136A6F))
call TimerStart(ydl_timer,.01,false,function Trig____________________094Func003Func002Func001T)
else
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$F84F61A8,GetRandomInt(10,20))
set udg_JF[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=udg_JF[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]+LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$F84F61A8)
call DzAPI_Map_StoreInteger(ConvertedPlayer(GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))),"JF",udg_JF[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
call DzAPI_Map_Stat_SetStat(GetOwningPlayer(GetTriggerUnit()),"JF",I2S(udg_JF[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]))
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"开启礼物获得："+(I2S(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$F84F61A8))+"积分"))
endif
else
endif
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
set ydl_timer=null
endfunction
