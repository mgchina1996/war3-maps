if LoadBoolean(YDHT,StringHash("小天使挑战2"),$15B8B0AD)==true then
call SaveInteger(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$3E3D3748,0)
else
endif
if GetTriggerUnit()==udg_AYX[36] and LoadBoolean(YDHT,StringHash("妹红R"),$304D9EF5)==false and GetUnitAbilityLevel(GetTriggerUnit(),$41305352)>=1 then
call SaveLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476,GetUnitLoc(GetTriggerUnit()))
call ReviveHeroLoc(GetTriggerUnit(),LoadLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476),true)
call IssueImmediateOrder(GetTriggerUnit(),"stomp")
call SelectUnitForPlayerSingle(udg_AYX[36],GetOwningPlayer(udg_AYX[36]))
set ydl_timer=CreateTimer()
call TimerStart(ydl_timer,.2,false,function Trig_990____________uFunc003Func005T)
call RemoveLocation(LoadLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476))
else
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC)<=20+R2I(100.*LoadReal(YDHT,GetHandleId(udg_e025),$EC264536)) and IsUnitOwnedByPlayer(udg_e025,Player(0))==true or IsUnitOwnedByPlayer(udg_e025,Player(1))==true or IsUnitOwnedByPlayer(udg_e025,Player(2))==true or IsUnitOwnedByPlayer(udg_e025,Player(3))==true or IsUnitOwnedByPlayer(udg_e025,Player(4))==true then
