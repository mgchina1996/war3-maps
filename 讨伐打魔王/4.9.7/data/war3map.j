call TriggerAddCondition(gg_trg__________________________010,Condition(function Trig__________________________010Conditions))
call TriggerAddAction(gg_trg__________________________010,function Trig__________________________010Actions)
endfunction
function Trig__________________________011Conditions takes nothing returns boolean
return IsUnitType(udg_wjyx[GetPlayerId(GetOwningPlayer(GetKillingUnitBJ()))],UNIT_TYPE_DEAD)==false and YDWEUnitHasItemOfTypeBJNull(udg_wjyx[GetPlayerId(GetOwningPlayer(GetKillingUnitBJ()))],udg_XYlx[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])==true
