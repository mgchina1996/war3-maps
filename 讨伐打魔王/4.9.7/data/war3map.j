call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call DisableTrigger(GetTriggeringTrigger())
call SaveReal(YDHT,GetHandleId(gg_unit_E03L_0260),$9049C539,LoadReal(YDHT,GetHandleId(gg_unit_E03L_0260),$9049C539)+.25)
call SaveReal(YDHT,GetHandleId(gg_unit_E03L_0260),$1E7EDE15,LoadReal(YDHT,GetHandleId(gg_unit_E03L_0260),$1E7EDE15)+.25)
call SaveReal(YDHT,GetHandleId(gg_unit_E03L_0260),$F2C728F,LoadReal(YDHT,GetHandleId(gg_unit_E03L_0260),$F2C728F)+.25)
call SaveBoolean(YDHT,StringHash("记忆碎片"),$9603093A,true)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8B1FFFFC,R2I(10.+10.*(I2R(udg_ZXRS-1)*.15)))
