call SaveLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476,GetUnitLoc(GetTriggerUnit()))
call PlaySoundAtPointBJ(gg_snd_HTYHMJ,100,LoadLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476),0)
call RemoveLocation(LoadLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476))
call DisplayTextToForce(GetPlayersAll(),"|cFF33CCFF黑铁一辉：这就是我的剑术『模仿剑技（Blade steal）』|r")
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"获得专属|cffffcc00「阴铁」|r")
call DestroyForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB))
call UnitAddItemByIdSwapped($49304B4E,GetTriggerUnit())
call DestroyTrigger(GetTriggeringTrigger())
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
