set udg_JYBL[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=udg_JYBL[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]+.35
call SetPlayerHandicapXP(GetOwningPlayer(GetTriggerUnit()),1.+udg_JYBL[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$17894772,true)
call SaveBoolean(YDHT,GetHandleId(GetOwningPlayer(GetTriggerUnit())),$FA186505,true)
else
call DisplayTextToForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB),"你已经获得buff了！")
endif
call DestroyForce(LoadForceHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$DFB448FB))
